{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "构建当前文件",
      "type": "shell",
      "command": "${workspaceFolder}\\build.bat",
      "args": [
        "${file}"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": [
        "$gcc"
      ],
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      },
      "detail": "编译当前打开的 .cpp 到 <题目目录>/build/<名字>.exe"
    },
